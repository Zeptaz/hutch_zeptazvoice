ENVIRONMENT=development
HOST=0.0.0.0
PORT=8088
ZEPTAZ_PUBLIC_BASE_URL=http://127.0.0.1:8088
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_END_SILENCE_MS=700
# BCP-47 hints for caller speech recognition (comma separated).
GEMINI_LIVE_INPUT_LANGUAGES=si-LK,en-US,ta-IN
HUTCH_RESOLVE_BASE_URL=http://localhost:8080/api/v1
HUTCH_RESOLVE_HMAC_SECRET=replace-with-the-same-secret-configured-in-resolve
HUTCH_VOICE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HUTCH_VOICE_GRANT_SECRET=replace-with-a-different-32-byte-random-secret
HUTCH_VOICE_GRANT_TTL_SECONDS=60
HUTCH_VOICE_STORE_PATH=.runtime/hutch_voice.sqlite3
HUTCH_VOICE_MAX_SESSION_SECONDS=600
# Optional: defaults to (call limit + 10 s) of continuous 16 kHz microphone audio; lower values are raised to that.
# HUTCH_VOICE_MAX_AUDIO_BYTES=19520000
GEMINI_LIVE_CONNECT_TIMEOUT_SECONDS=12
HUTCH_RESOLVE_CONNECT_TIMEOUT_SECONDS=2
HUTCH_RESOLVE_READ_TIMEOUT_SECONDS=8
